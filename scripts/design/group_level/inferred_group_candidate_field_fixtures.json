    "scale": [
      {
        "id": "relative_gap_rank",
        "parameters": {
          "quantiles": [
            0.25,
            0.5,
            0.75
          ],
          "rank_method": "inclusive_linear"
        },
        "formula": "include pair when normalized_gap <= inclusive_linear_quantile(all computed normalized gaps, q)",
        "provenance": "pre-registered D1 relative scale; no absolute distance threshold"
      },
      {
        "id": "local_persistence_window",
        "parameters": {
          "windows": [
            1,
            2,
            3
          ],
          "persistence": [
            1,
            2
          ]
        },
        "formula": "rank neighbors by normalized_gap per endpoint; include pair when max(endpoint ranks) <= window and it persists in at least p declared windows",
        "provenance": "pre-registered D1 local-neighborhood scale"
      },
      {
        "id": "space_profile_rank",
        "parameters": {
          "quantiles": [
            0.5,
            0.75
          ],
          "rank_direction": "higher_is_more_supportive"
        },
        "formula": "include pair when declared space profile >= inclusive_linear_quantile(available profiles, q)",
        "provenance": "pre-registered D1 space-field scale; absent profiles remain missing"
      }
    ],
    "aggregation": [
      {
        "id": "all_pairs",
        "parameters": {
          "rule": "all internal pair keys must be selected"
        },
        "provenance": "parallel aggregation comparison; no production choice"
      },
      {
        "id": "max_span",
        "parameters": {
          "rule": "max internal normalized gap must be <= current scale bound"
        },
        "provenance": "bounded-cohesion diagnostic only"
      },
      {
        "id": "min_gap",
        "parameters": {
          "rule": "retain each selected pair as a two-member candidate"
        },
        "provenance": "witness diagnostic only"
      },
      {
        "id": "complete_link_diagnostic",
        "parameters": {
          "rule": "maximal cliques of selected pair graph"
        },
        "provenance": "chaining/complete-link diagnostic only"
      }
    ]
  },
